# Backend Environment Variables
# Copy this file to .env and customize values

# Application
APP_ENV=development
APP_NAME=Fall Detection API
VERSION=1.0.0

# CORS - Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# WebSocket Settings
WS_MAX_FPS=15
FRAME_RATE_LIMIT=30
MAX_FRAME_SIZE=1048576
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10

# Artifacts
ARTIFACT_DIR=./artifacts
MAX_UPLOAD_SIZE=104857600

# Core AI Paths (relative to backend directory)
CORE_CONFIG_PATH=../urfd_fall_yolo_pose/configs/default.yaml
YOLO_MODEL_PATH=../urfd_fall_yolo_pose/yolov8s-pose.pt
CORE_SCRIPTS_DIR=../urfd_fall_yolo_pose/scripts

# Logging
LOG_LEVEL=INFO

# Rate Limiting
BURST_ALLOWANCE=5
