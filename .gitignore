*.mp4
*.avi
*.mov
*.mkv

# Images (general)
*.jpg
*.jpeg
*.png

# Allow documentation images
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!README*.png
!README*.jpg
!README*.jpeg

# Allow plots (already specified above, but being explicit)
!**/plots/*.png
!**/plots/*.jpg

