*.pt
*.pth
*.onnx
*.weights
*.caffemodel
# Allow specific model file
!yolov8s-pose.pt

# ============================================================================
# Data and Outputs
# ============================================================================
# Raw dataset
data/

# Output videos (large files)
urfd_fall_yolo_pose/outputs/videos/
outputs/videos/

# Output results and metrics (auto-generated)
urfd_fall_yolo_pose/outputs/*.csv
urfd_fall_yolo_pose/outputs/*.json
outputs/*.csv
outputs/*.json

# YOLO training runs
urfd_fall_yolo_pose/runs/
runs/

# Generic outputs and artifacts
artifacts/

# Allow specific CSV files
!*_index.csv
!urfd_*.csv
!requirements.txt

# Allow plots directory (for GitHub)
!urfd_fall_yolo_pose/outputs/plots/
!urfd_fall_yolo_pose/outputs/plots/*.png
!outputs/plots/
!outputs/plots/*.png

# ============================================================================
# Web Application
# ============================================================================
# Backend artifacts
web/backend/artifacts/
web/backend/runs/

# Frontend
web/frontend/node_modules/
web/frontend/dist/
web/frontend/.next/
web/frontend/build/

# ============================================================================
